# WebMCP stays local-first by default.
LOCAL_ONLY=true

# Optional production adapters. Leave empty for deterministic demo mode.
COMFYUI_BASE_URL=
H3_BASE_URL=

# ---------------------------------------------------------------------------
# Phase 19 — Pao AI Generation Studio (ComfyUI production orchestrator)
# ---------------------------------------------------------------------------

# Master feature flag. false hides AI Studio and stops the job worker;
# the rest of Pao-hubPro is unaffected either way.
PAO_GENERATION_ENABLED=true

# ComfyUI provider. The default targets a local install; override for a remote
# or second GPU host. Business logic never hardcodes this URL.
PAO_COMFYUI_BASE_URL=http://127.0.0.1:8188
PAO_COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
PAO_COMFYUI_TIMEOUT_SECONDS=600
PAO_COMFYUI_MAX_CONCURRENCY=1

# Persistent job queue
PAO_GENERATION_DEFAULT_PRIORITY=5
PAO_GENERATION_MAX_RETRIES=2
PAO_GENERATION_MAX_AUTO_REWORK=2

# Upload validation
PAO_MAX_IMAGE_UPLOAD_MB=50
PAO_MAX_VIDEO_UPLOAD_MB=2048
PAO_MAX_AUDIO_UPLOAD_MB=200

# Asset storage (paths are workspace-relative or absolute; Windows-safe)
PAO_GENERATION_STORAGE_PATH=./data/generation
PAO_GENERATION_TEMP_PATH=./data/tmp/generation

# CORS: explicit origins only. Never use * in production.
PAO_ALLOWED_ORIGINS=http://localhost:3000

# Retention
PAO_GENERATION_TEMP_RETENTION_HOURS=24
PAO_GENERATION_JOB_LOG_RETENTION_DAYS=30

# Adobe Stock Mode scoring thresholds
PAO_STOCK_READY_SCORE=85
PAO_STOCK_MANUAL_REVIEW_SCORE=75

# ---------------------------------------------------------------------------
# Phase 20 — Pao Multi-GPU Generation Grid × RunPod Intelligent Workload Router
# ---------------------------------------------------------------------------

# RunPod integration feature flag (default: false = zero cloud spend, local-only)
PAO_RUNPOD_ENABLED=false

# RunPod API Key (Never commit real API keys; store securely)
PAO_RUNPOD_API_KEY=

# RunPod GraphQL API endpoint
PAO_RUNPOD_API_BASE_URL=https://api.runpod.io/graphql

# Default RunPod ComfyUI pod template ID
PAO_RUNPOD_DEFAULT_TEMPLATE_ID=hs44di56w7

# FinOps Cost Guardrails (Daily and monthly hard spending caps)
PAO_RUNPOD_DAILY_BUDGET=15.00
PAO_RUNPOD_MONTHLY_BUDGET=100.00
PAO_RUNPOD_MAX_COST_PER_JOB=2.00
PAO_RUNPOD_MAX_HOURLY_GPU_PRICE=1.50

# Concurrency & Cloud Bursting (Phase 20 Base)
PAO_RUNPOD_MAX_ACTIVE_PODS=3
PAO_GPU_PREFER_LOCAL=true
PAO_CLOUD_BURST_QUEUE_THRESHOLD=3

# Lifecycle & Idle Resource Termination
PAO_RUNPOD_AUTO_STOP_IDLE_MINUTES=10
PAO_RUNPOD_AUTO_TERMINATE_IDLE_MINUTES=60

# ---------------------------------------------------------------------------
# Phase 20.1: Pao ComfyUI Smart Queue × Auto Cloud Burst Scheduler
# ---------------------------------------------------------------------------
# Enable Smart Queue orchestration layer (default: true)
PAO_SMART_QUEUE_ENABLED=true

# Native ComfyUI observer poll interval in seconds (default: 3)
PAO_QUEUE_OBSERVER_INTERVAL_SECONDS=3

# Cloud burst policy mode: off | manual | assisted | auto (default: assisted)
PAO_QUEUE_BURST_MODE=assisted

# Queue depth trigger thresholds for cloud burst recommendations
PAO_QUEUE_BURST_SOFT_DEPTH=4
PAO_QUEUE_BURST_HARD_DEPTH=12

# Target backlog drain time in minutes (default: 20)
PAO_QUEUE_TARGET_DRAIN_MINUTES=20
PAO_QUEUE_MAX_LOCAL_WAIT_MINUTES=30
PAO_QUEUE_MIN_BURST_TIME_SAVING_PERCENT=20

# Scale-up / scale-down hysteresis guards to prevent rapid flapping
PAO_QUEUE_SCALE_UP_COOLDOWN_SECONDS=60
PAO_QUEUE_SCALE_UP_STABLE_WINDOW_SECONDS=30
PAO_QUEUE_SCALE_DOWN_COOLDOWN_SECONDS=300
PAO_QUEUE_SCALE_DOWN_STABLE_WINDOW_SECONDS=120

# Dispatch Window: strictly 1 running + 1 prefetch slot per active GPU worker
PAO_QUEUE_MAX_PREFETCH_JOBS_PER_PROVIDER=2
PAO_QUEUE_PROVIDER_MAX_PENDING=2

# Batch affinity chunking & warm model cache retention
PAO_QUEUE_BATCH_CHUNK_SIZE=5
PAO_QUEUE_MAX_CONCURRENT_PER_PROJECT=4
PAO_QUEUE_AFFINITY_WARM_MINUTES=20
PAO_QUEUE_AGGRESSIVE_SCALE_UP=false

# Never commit real credentials. Keep them in the OS keyring or private .env.

# ---------------------------------------------------------------------------
# Phase 20.17: Pao Adaptive LLM Gateway × Experiential
# ---------------------------------------------------------------------------
# The router is the layer that decides WHICH model class a task needs. It extends
# the Phase 20.13 gateway rather than replacing it: aliases, budget ceilings,
# privacy classes, and the identity policy all keep working.

# Prefer the cheapest ELIGIBLE candidate. Free is never chosen for its own sake:
# a candidate that cannot meet the request's capabilities is filtered out first.
PAO_LLM_FREE_FIRST=true

# Per-agent ceiling on ladder climbs. 0 means never escalate.
PAO_LLM_MAX_ESCALATIONS=2

# Emergency direct-provider path, for use when the gateway itself is down.
# OFF by default. Only the literal string "true" enables it — "1", "yes", and
# "TRUE" do NOT — and enabling it still requires naming providers in
# DIRECT_BYPASS_PROVIDERS, because an enabled bypass with an empty allowlist
# routes nothing.
PAO_LLM_DIRECT_BYPASS=false
DIRECT_BYPASS_PROVIDERS=

# A task classified private prefers a local route; a task classified restricted
# is pinned to the local route and may not escalate onto a public provider.
PAO_LLM_PRIVATE_TASK_LOCAL_ONLY=true

# Experiential gateway (external, OpenAI-compatible). Upstream is Apache-2.0 and
# is pinned in config/ai-gateway/upstream.lock.yaml. A floating version is refused
# at boot. EXPERIENTIAL_API_KEY is a GATEWAY key issued by the gateway, not a
# provider key.
EXPERIENTIAL_BASE_URL=http://127.0.0.1:8000/v1
EXPERIENTIAL_API_KEY=

# ---------------------------------------------------------------------------
# Phase 20.18: Pao Grok Production Bridge
# ---------------------------------------------------------------------------
# The bridge is local-only. Its host is NOT configurable: it always binds to
# 127.0.0.1, so no setting here can expose it on a public interface.
PAO_BRIDGE_PORT=43117

# Wire credential. If unset, a token is derived from the user profile so a local
# single-user install works without configuration. That derived value is NOT a
# secret, which is why pairing exists: holding the token is not sufficient to
# attach without having completed a pairing exchange.
PAO_BRIDGE_TOKEN=

# Optional seed for deriving the token instead of using a literal.
PAO_BRIDGE_SEED=

# Extension ids allowed to call the bridge, comma-separated. chrome://extensions
# shows the id after "Load unpacked", and it is stable for a given directory path.
#
# AN EMPTY VALUE PERMITS NO EXTENSION. That is the correct default: it means an
# unrelated extension cannot attach even if it learns the port and the token.
# Loading the extension without setting this will produce a 401 on every request.
# Example: PAO_BRIDGE_EXTENSION_IDS=abcdefghijklmnopabcdefghijklmnop
PAO_BRIDGE_EXTENSION_IDS=

# Where downloaded assets and their provenance manifests are written.
PAO_BRIDGE_DOWNLOADS_ROOT=./downloads

# ---------------------------------------------------------------------------
# Phase 20.15: Pao-hubPro Domain Control Plane
# ---------------------------------------------------------------------------
# Master feature flag (default: false — the control plane is inert until enabled).
DOMAIN_CONTROL_ENABLED=false

# Provider selection. "fake" is the in-memory rehearsal provider: it needs no
# credential and no network, and is the required first step before any real
# provider is enabled. "domain_oss" reaches DigitalPlat Domain-OSS over HTTP.
DOMAIN_DEFAULT_PROVIDER=fake

# DigitalPlat Domain-OSS adapter. Leave the base URL empty to keep the provider
# unregistered — an unconfigured install cannot reach a placeholder host.
# Domain-OSS is an independent AGPL-3.0 service: it is called over its REST API and
# its source is never vendored into this repository.
DOMAIN_OSS_BASE_URL=
# Bearer token with domains:read/domains:write and dns:read/dns:write scopes.
# Use a scoped key, never a global administrative credential.
DOMAIN_OSS_API_KEY=

# ---------------------------------------------------------------------------
# Safety gates — these are the reason the control plane exists.
# ---------------------------------------------------------------------------
# Registrable zones this installation may touch. Comma-separated.
# AN EMPTY ALLOWLIST FREEZES EVERY MUTATION. This is intentional: an unconfigured
# install must be incapable of changing DNS.
# Example: DOMAIN_CONTROL_ALLOWLIST=example.com,dev-example.example.net
DOMAIN_CONTROL_ALLOWLIST=

# Explicit denials, evaluated BEFORE the allowlist so they can carve exceptions out
# of an allowed zone. Example: DOMAIN_CONTROL_DENYLIST=mail.example.com
DOMAIN_CONTROL_DENYLIST=

# Zones treated as production regardless of any other signal. Production mutations
# are classified high/critical and always require an approval.
DOMAIN_CONTROL_PRODUCTION_ZONES=

# Require a granted approval before any mutation (default: true).
DOMAIN_REQUIRE_APPROVAL=true

# How long a granted approval stays valid before it must be requested again.
DOMAIN_APPROVAL_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Verification
# ---------------------------------------------------------------------------
# Resolvers used for multi-resolver propagation checking. More than one is the
# point: a single resolver agreeing with itself is not evidence of propagation.
DNS_VERIFY_RESOLVERS=1.1.1.1,8.8.8.8
DNS_VERIFY_TIMEOUT_SECONDS=30
DNS_VERIFY_INTERVAL_SECONDS=3

# ---------------------------------------------------------------------------
# Reverse proxy (optional)
# ---------------------------------------------------------------------------
# Caddy admin API endpoint. Empty means the proxy adapter reports itself
# unavailable and deployment steps say so, rather than silently doing nothing.
# Example: http://127.0.0.1:2019
CADDY_ADMIN_URL=
# Only needed when the Caddy admin API is protected by a bearer token.
CADDY_API_TOKEN=

# Never commit real credentials. Keep them in the OS keyring or private .env.

# ---------------------------------------------------------------------------
# Phase 20.2: Pao Spec-Driven AI SDLC Orchestrator × Reviewer Council
# ---------------------------------------------------------------------------
# Master switch for SDLC orchestration layer (default: true)
PAO_SDLC_ENABLED=true

# Default autorun mode: MANUAL | GUIDED | AUTO_UNTIL_APPROVAL | FULL_AUTO_SAFE_ONLY
PAO_SDLC_DEFAULT_MODE=GUIDED

# Enable multi-role AI Reviewer Council by default
PAO_SDLC_AUTO_REVIEW=true

# Strict quality gate blocking on failures
PAO_SDLC_STRICT_GATES=true

# Safety guard: refuse execution if git working tree has uncommitted edits (default: false)
PAO_SDLC_ALLOW_DIRTY_TREE=false

# Git branch prefix for automatic isolated feature branches
PAO_SDLC_DEFAULT_BRANCH_PREFIX=feature/

# Task execution and worker concurrency controls
PAO_SDLC_MAX_CONCURRENT_TASKS=4
PAO_SDLC_COMMAND_TIMEOUT_MS=60000
PAO_SDLC_APPROVAL_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# Phase 20.13: Pao AI Gateway & Model Router
# ---------------------------------------------------------------------------
# Master feature flag (default: false = gateway not started)
PAO_AI_GATEWAY_ENABLED=false

# Gateway listener port (default: 8787)
PAO_AI_GATEWAY_PORT=8787

# Trace content mode: off | metadata_only | redacted | full_local_encrypted
PAO_AI_GATEWAY_TRACE_MODE=metadata_only

# Admin master key for gateway management API
PAO_AI_GATEWAY_ADMIN_KEY=

# ---------------------------------------------------------------------------
# Phase 20.51: AI Gateway governance (quota-aware routing, bounded fallback,
# circuit breakers, decision ledger) + 9Router gateway sidecar
# ---------------------------------------------------------------------------
# Master switch for governed routing. Strictly "true" to enable (same rule as
# PAO_LLM_DIRECT_BYPASS); governance.yaml can still disable it.
PAO_AI_GATEWAY_GOVERNANCE=false

# 9Router sidecar (deploy/9router/). Loopback-only by default; provider
# credentials stay inside the 9Router process.
PAO_AI_GATEWAY_NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
PAO_AI_GATEWAY_NINE_ROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Phase 20.52: Market Signal Control Plane (paper-trading-first)
# ---------------------------------------------------------------------------
# Master switch (strictly "true"). Live execution does not exist in this
# phase and cannot be enabled by configuration.
MARKET_MODULE_ENABLED=false
MARKET_MODULE_PORT=8790
MARKET_ADMIN_KEY=

# Webhook ingress security
MARKET_WEBHOOK_MAX_AGE_SECONDS=300
MARKET_WEBHOOK_MAX_BODY_KB=256
MARKET_WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# Risk limits (deterministic; AI can never change them)
MARKET_DEFAULT_RISK_PERCENT=0.50
MARKET_MAX_RISK_PER_TRADE_PERCENT=1.00
MARKET_MAX_DAILY_LOSS_PERCENT=3.00
MARKET_MAX_OPEN_POSITIONS=5
MARKET_MAX_SYMBOL_EXPOSURE_PERCENT=20
MARKET_MAX_GROSS_EXPOSURE_PERCENT=100
MARKET_MAX_DRAWDOWN_PERCENT=10

# Human approval + paper execution
MARKET_APPROVAL_EXPIRY_MINUTES=30
PAPER_BROKER_SLIPPAGE_BPS=0
MARKET_PAPER_EQUITY=100000
# Comma-separated user ids permitted to resolve approvals / manage providers
# and the circuit breaker. Empty = nobody (fail closed).
MARKET_APPROVER_ACTORS=
MARKET_OPERATOR_ACTORS=

# AI analysis (advisory only; output passes the hallucination guard)
MARKET_AI_ANALYSIS_ENABLED=true
MARKET_REVIEWER_COUNCIL_ENABLED=true

# Providers (all disabled by default; secrets resolve from env at verify time)
MARKET_PROVIDER_KAMDEN_ENABLED=false
MARKET_KAMDEN_WEBHOOK_SECRET=
MARKET_PROVIDER_TRADINGVIEW_ENABLED=false
MARKET_TRADINGVIEW_WEBHOOK_SECRET=
MARKET_PROVIDER_GENERIC_ENABLED=false
MARKET_GENERIC_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Phase 20.53: Context Control Plane (OpenViking sidecar, governed memory)
