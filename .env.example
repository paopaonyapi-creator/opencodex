# ---------------------------------------------------------------------------
# Phase 20.82/20.84/20.85 — CortexKit AFT × TypeSafe Jev × OmniRoute
# (docs/PHASE_20.82_AFT_SENSORIMOTOR_RUNTIME.md)
# ---------------------------------------------------------------------------
# Phase 20.85 OmniRoute unified model gateway. Offline daemon = DEGRADED, the
# runtime keeps serving through the direct/local adapter — never a crash.
PAO_OMNIROUTE_ENABLED=true
# Loopback daemon by default; override for a remote gateway. http/https only,
# no credentials in the URL (use PAO_OMNIROUTE_API_KEY instead).
PAO_OMNIROUTE_BASE_URL=http://127.0.0.1:9090
# Bearer credential for the OmniRoute daemon. Environment only; never commit.
PAO_OMNIROUTE_API_KEY=
# Per-request timeout and bounded retry budget for the OmniRoute adapter.
PAO_OMNIROUTE_TIMEOUT_MS=30000
PAO_OMNIROUTE_RETRY_MAX=2
# Connection-health probe cache TTL (readiness checks never hammer the daemon).
PAO_OMNIROUTE_HEALTH_TTL_MS=15000
# A fresh cached "unreachable" probe short-circuits requests into structured
# failures (immediate direct-adapter fallback). false = always attempt.
PAO_OMNIROUTE_FAST_FAIL=true

# Phase 20.84 TypeSafe Jev decision provider. Runtime selection:
#   real      — TypeSafe early-access endpoint; requires TYPESAFE_API_KEY AND
#               the official bound schema. Missing either = structured
#               JEV_UNAVAILABLE + audited deterministic fallback. No substitute
#               endpoint is ever fabricated.
#   simulated — local calibrated simulation (development/test backend).
#   disabled  — deterministic rule provider only.
PAO_JEV_PROVIDER=simulated
# TypeSafe early-access credential. Environment only; never commit. Leave
# empty until TypeSafe grants access — the runtime reports degraded, honestly.
TYPESAFE_API_KEY=

# Phase 20.82 AFT sensorimotor transaction safety.
# A session idle longer than this is stale and refuses new actions.
PAO_AFT_SESSION_STALE_MS=86400000
# Max wait for the per-workspace transaction lock before an action fails with
# SENSORIMOTOR_LOCK_TIMEOUT (retryable) instead of queueing indefinitely.
PAO_AFT_LOCK_WAIT_MS=30000

# ---------------------------------------------------------------------------
# Phase 20.89 — Pao-hubPro × Bubble — Capability Hub (registry-first marketplace)
# ---------------------------------------------------------------------------
# Master switch. Registry stays local-first; no public monetization in this phase.
PAOHUB_MARKETPLACE_ENABLED=true
PAOHUB_MARKETPLACE_AUTO_SYNC=false
PAOHUB_MARKETPLACE_AUTO_VERIFY=false
PAOHUB_MARKETPLACE_ADAPTER_GEN=true
PAOHUB_MARKETPLACE_OMNIROUTE_PUBLISH=false
PAOHUB_MARKETPLACE_MCP_PUBLISH=true
# Extra blueprint directories (beyond the tracked Blueprint/ folder) for the
# Phase Importer, separated by ';' (Windows) or ':' (POSIX).
PAOHUB_MARKETPLACE_EXTRA_BLUEPRINT_DIRS=

# Phase 20.91b — Engineering Skill Runtime (Addy Osmani Agent Skills; proposed 20.93).
PAO_PHASE_20_91_ENABLED=true
PAO_EXTERNAL_SKILL_PACKS_ENABLED=true
PAO_ENGINEERING_SKILL_ROUTER_ENABLED=true
PAO_EVIDENCE_GATES_ENABLED=true
PAO_REVIEWER_COUNCIL_ENABLED=true
# SKILL_PACK_AUTO_UPDATE is statically false in code (never auto-promote pack updates).
