# WebMCP stays local-first by default.
LOCAL_ONLY=true

# Optional production adapters. Leave empty for deterministic demo mode.
COMFYUI_BASE_URL=
H3_BASE_URL=

# ---------------------------------------------------------------------------
# Phase 19 — Pao AI Generation Studio (ComfyUI production orchestrator)
# ---------------------------------------------------------------------------

# Master feature flag. false hides AI Studio and stops the job worker;
# the rest of Pao-hubPro is unaffected either way.
PAO_GENERATION_ENABLED=true

# ComfyUI provider. The default targets a local install; override for a remote
# or second GPU host. Business logic never hardcodes this URL.
PAO_COMFYUI_BASE_URL=http://127.0.0.1:8188
PAO_COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
PAO_COMFYUI_TIMEOUT_SECONDS=600
PAO_COMFYUI_MAX_CONCURRENCY=1

# Persistent job queue
PAO_GENERATION_DEFAULT_PRIORITY=5
PAO_GENERATION_MAX_RETRIES=2
PAO_GENERATION_MAX_AUTO_REWORK=2

# Upload validation
PAO_MAX_IMAGE_UPLOAD_MB=50
PAO_MAX_VIDEO_UPLOAD_MB=2048
PAO_MAX_AUDIO_UPLOAD_MB=200

# Asset storage (paths are workspace-relative or absolute; Windows-safe)
PAO_GENERATION_STORAGE_PATH=./data/generation
PAO_GENERATION_TEMP_PATH=./data/tmp/generation

# CORS: explicit origins only. Never use * in production.
PAO_ALLOWED_ORIGINS=http://localhost:3000

# Retention
PAO_GENERATION_TEMP_RETENTION_HOURS=24
PAO_GENERATION_JOB_LOG_RETENTION_DAYS=30

# Adobe Stock Mode scoring thresholds
PAO_STOCK_READY_SCORE=85
PAO_STOCK_MANUAL_REVIEW_SCORE=75

# ---------------------------------------------------------------------------
# Phase 20 — Pao Multi-GPU Generation Grid × RunPod Intelligent Workload Router
# ---------------------------------------------------------------------------

# RunPod integration feature flag (default: false = zero cloud spend, local-only)
PAO_RUNPOD_ENABLED=false

# RunPod API Key (Never commit real API keys; store securely)
PAO_RUNPOD_API_KEY=

# RunPod GraphQL API endpoint
PAO_RUNPOD_API_BASE_URL=https://api.runpod.io/graphql

# Default RunPod ComfyUI pod template ID
PAO_RUNPOD_DEFAULT_TEMPLATE_ID=hs44di56w7

# FinOps Cost Guardrails (Daily and monthly hard spending caps)
PAO_RUNPOD_DAILY_BUDGET=15.00
PAO_RUNPOD_MONTHLY_BUDGET=100.00
PAO_RUNPOD_MAX_COST_PER_JOB=2.00
PAO_RUNPOD_MAX_HOURLY_GPU_PRICE=1.50

# Concurrency & Cloud Bursting (Phase 20 Base)
PAO_RUNPOD_MAX_ACTIVE_PODS=3
PAO_GPU_PREFER_LOCAL=true
PAO_CLOUD_BURST_QUEUE_THRESHOLD=3

# Lifecycle & Idle Resource Termination
PAO_RUNPOD_AUTO_STOP_IDLE_MINUTES=10
PAO_RUNPOD_AUTO_TERMINATE_IDLE_MINUTES=60

# ---------------------------------------------------------------------------
# Phase 20.1: Pao ComfyUI Smart Queue × Auto Cloud Burst Scheduler
# ---------------------------------------------------------------------------
# Enable Smart Queue orchestration layer (default: true)
PAO_SMART_QUEUE_ENABLED=true

# Native ComfyUI observer poll interval in seconds (default: 3)
PAO_QUEUE_OBSERVER_INTERVAL_SECONDS=3

# Cloud burst policy mode: off | manual | assisted | auto (default: assisted)
PAO_QUEUE_BURST_MODE=assisted

# Queue depth trigger thresholds for cloud burst recommendations
PAO_QUEUE_BURST_SOFT_DEPTH=4
PAO_QUEUE_BURST_HARD_DEPTH=12

# Target backlog drain time in minutes (default: 20)
PAO_QUEUE_TARGET_DRAIN_MINUTES=20
PAO_QUEUE_MAX_LOCAL_WAIT_MINUTES=30
PAO_QUEUE_MIN_BURST_TIME_SAVING_PERCENT=20

# Scale-up / scale-down hysteresis guards to prevent rapid flapping
PAO_QUEUE_SCALE_UP_COOLDOWN_SECONDS=60
PAO_QUEUE_SCALE_UP_STABLE_WINDOW_SECONDS=30
PAO_QUEUE_SCALE_DOWN_COOLDOWN_SECONDS=300
PAO_QUEUE_SCALE_DOWN_STABLE_WINDOW_SECONDS=120

# Dispatch Window: strictly 1 running + 1 prefetch slot per active GPU worker
PAO_QUEUE_MAX_PREFETCH_JOBS_PER_PROVIDER=2
PAO_QUEUE_PROVIDER_MAX_PENDING=2

# Batch affinity chunking & warm model cache retention
PAO_QUEUE_BATCH_CHUNK_SIZE=5
PAO_QUEUE_MAX_CONCURRENT_PER_PROJECT=4
PAO_QUEUE_AFFINITY_WARM_MINUTES=20
PAO_QUEUE_AGGRESSIVE_SCALE_UP=false

# Never commit real credentials. Keep them in the OS keyring or private .env.

# ---------------------------------------------------------------------------
# Phase 20.2: Pao Spec-Driven AI SDLC Orchestrator × Reviewer Council
# ---------------------------------------------------------------------------
# Master switch for SDLC orchestration layer (default: true)
PAO_SDLC_ENABLED=true

# Default autorun mode: MANUAL | GUIDED | AUTO_UNTIL_APPROVAL | FULL_AUTO_SAFE_ONLY
PAO_SDLC_DEFAULT_MODE=GUIDED

# Enable multi-role AI Reviewer Council by default
PAO_SDLC_AUTO_REVIEW=true

# Strict quality gate blocking on failures
PAO_SDLC_STRICT_GATES=true

# Safety guard: refuse execution if git working tree has uncommitted edits (default: false)
PAO_SDLC_ALLOW_DIRTY_TREE=false

# Git branch prefix for automatic isolated feature branches
PAO_SDLC_DEFAULT_BRANCH_PREFIX=feature/

# Task execution and worker concurrency controls
PAO_SDLC_MAX_CONCURRENT_TASKS=4
PAO_SDLC_COMMAND_TIMEOUT_MS=60000
PAO_SDLC_APPROVAL_EXPIRY_MINUTES=60
