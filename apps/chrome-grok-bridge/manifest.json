{
  "manifest_version": 3,
  "name": "Pao Grok Bridge",
  "version": "0.1.0",
  "description": "Bridges Grok Projects and Imagine into the Pao-hubPro generation queue. Local-only, human-in-the-loop.",
  "minimum_chrome_version": "116",

  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "scripting"
  ],

  "host_permissions": [
    "https://grok.com/*",
    "https://*.grok.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://grok.com/*", "https://*.grok.com/*"],
      "js": [
        "src/content/selectors.js",
        "src/content/grok-detector.js",
        "src/content/observer.js",
        "src/content/uploader.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Pao Grok Bridge"
  },

  "options_page": "src/options/options.html",

  "web_accessible_resources": [],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
