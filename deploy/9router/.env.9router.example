# Phase 20.51 — 9Router sidecar environment (example).
# Copy to .env.9router and fill in. Never commit real secrets.

# Port the sidecar listens on inside the container (default matches compose).
NINE_ROUTER_PORT=20128

# The key Pao-hubPro uses to reach the 9Router OpenAI-compatible surface.
# Leave empty for a loopback-only deployment without gateway auth.
PAO_AI_GATEWAY_NINE_ROUTER_API_KEY=
