# Phase 20.53 — OpenViking sidecar environment (example).
# Copy to .env.openviking and fill in. Never commit real secrets.

# The key Pao-hubPro uses to reach OpenViking. Create a USER-level key in the
# OpenViking admin surface; the ROOT key must never be used by Pao services.
PAO_OPENVIKING_API_KEY=

# Backend location as seen from the Pao process (loopback by default).
PAO_OPENVIKING_URL=http://127.0.0.1:1933
