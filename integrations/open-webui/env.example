# Phase 20.33 — Open WebUI integration environment (copy to your private .env; never commit real values)
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.3
OPEN_WEBUI_INTERNAL_URL=http://127.0.0.1:8080
PAO_OPEN_WEBUI_URL=http://127.0.0.1:8080

# Pao provider router (the existing proxy) as Open WebUI's OpenAI-compatible backend
PAO_LLM_BASE_URL=http://host.docker.internal:PORT/v1
# Admin token the proxy writes to $OPENCODEX_HOME/admin-api-token (never commit)
PAO_PROXY_TOKEN=

# Policy-aware MCP gateway (Phase 20.33 JSON-RPC endpoint)
PAO_MCP_URL=http://host.docker.internal:PORT/api/agent-os/ai-workspace/mcp

# Governed shell/file tool scope (Phase 20.28 containment + Phase 20.33 providers)
PAO_ALLOWED_WORKSPACE_ROOTS=
PAO_DEFAULT_TOOL_TIMEOUT_SECONDS=120
PAO_TOOL_APPROVAL_ENABLED=true
PAO_COMMAND_POLICY_ENABLED=true
PAO_AUDIT_ENABLED=true
