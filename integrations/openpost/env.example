# OpenPost environment — copy to `.env` next to docker-compose.openpost.yml.
# Lock the file down after editing: chmod 600 .env
# Generate secrets with: openssl rand -base64 32

OPENPOST_APP_URL=http://localhost:8080
OPENPOST_PUBLIC_URL=http://localhost:8080
OPENPOST_MEDIA_URL=http://localhost:8080/media
OPENPOST_JWT_SECRET=replace-with-openssl-rand-base64-32
OPENPOST_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Recommended once initial setup is done:
# OPENPOST_DISABLE_REGISTRATIONS=true
